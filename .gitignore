# ============================================
# Dark Software Factory - .gitignore
# ============================================

# ============================================
# Node.js Dependencies
# ============================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# ============================================
# Build Outputs
# ============================================
dist/
build/
out/
*.tsbuildinfo
.next/
.nuxt/

# ============================================
# Environment Variables & Secrets
# ============================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.staging

# Keep example files
!.env.example
!.env.template

# API Keys and Secrets
*.key
*.pem
*.cert
secrets.json
secrets.yaml

# ============================================
# TypeScript
# ============================================
*.tsbuildinfo
.tscache/

# ============================================
# Testing & Coverage
# ============================================
coverage/
.nyc_output/
*.lcov
test-results/
junit.xml
*.spec.js.map
*.spec.d.ts

# ============================================
# Logs
# ============================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
pnpm-debug.log*

# Winston logs
combined.log
error.log
exceptions.log
rejections.log

# ============================================
# Databases
# ============================================
# PostgreSQL
*.sql
*.dump
pgdata/
postgres-data/

# SQLite (if used for testing)
*.sqlite
*.sqlite3
*.db

# Redis dump
dump.rdb

# Prisma
# Uncomment if you want to ignore generated Prisma Client
# node_modules/.prisma/
# prisma/migrations/**/migration.sql

# ============================================
# Docker
# ============================================
# Docker volumes and data
docker-compose.override.yml
.docker/
volumes/
data/

# Docker logs
docker-compose.log

# ============================================
# IDEs and Editors
# ============================================

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace


# JetBrains IDEs (WebStorm, IntelliJ IDEA, etc.)
.idea/
*.iml
*.iws
*.ipr
.idea_modules/
atlassian-ide-plugin.xml

# Vim
*.swp
*.swo
*~
.vim/

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc

# Sublime Text
*.sublime-project
*.sublime-workspace

# ============================================
# Operating Systems
# ============================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# ============================================
# Package Managers
# ============================================
package-lock.json
yarn.lock
pnpm-lock.yaml
.yarn/
.pnp.*

# Keep lockfiles (uncomment if you want to track them)
# !package-lock.json
# !yarn.lock
# !pnpm-lock.yaml

# ============================================
# Temporary Files
# ============================================
tmp/
temp/
*.tmp
*.temp
.cache/
.parcel-cache/

# ============================================
# Monitoring & Metrics
# ============================================
# Prometheus
prometheus-data/

# Grafana
grafana-data/

# ============================================
# CI/CD
# ============================================
.github/workflows/*.log

# ============================================
# Documentation
# ============================================
# Generated documentation
docs/api/generated/
typedoc/

# ============================================
# Frontend (if applicable)
# ============================================
# Next.js
.next/
out/

# React
.eslintcache

# Build artifacts
static/
public/build/

# ============================================
# Backup Files
# ============================================
*.backup
*.bak
*.old
*.orig

# ============================================
# Archives
# ============================================
*.zip
*.tar
*.tar.gz
*.rar
*.7z

# ============================================
# Media Files (Large)
# ============================================
# Uncomment if you don't want to track large media files
# *.mp4
# *.mov
# *.avi
# *.mkv
# *.mp3
# *.wav

# ============================================
# Project Specific
# ============================================

# AI Provider Responses (potentially large)
ai-responses/
ai-cache/

# Generated code from AI (if you want to review before committing)
# generated/

# Cost tracking data (may contain sensitive info)
cost-reports/
financial-data/

# Performance profiling
*.cpuprofile
*.heapprofile
*.heapsnapshot

# Sentry source maps (optional - some teams commit these)
# *.js.map
# *.map

# RabbitMQ data
rabbitmq-data/

# Execution logs and artifacts
execution-logs/
execution-artifacts/

# QA reports
qa-reports/
test-reports/

# Deployment artifacts
deployments/

# Agent tools temporary files
agent-tools/*.txt
agent-tools/*.json
agent-tools/*.log

# ============================================
# Security
# ============================================
# Never commit these patterns
*secret*
*password*
*token*
*credential*
*private*

# SSH keys
id_rsa
id_dsa
id_ecdsa
id_ed25519
*.pub

# GPG keys
*.gpg
*.asc

# ============================================
# Miscellaneous
# ============================================
.serverless/
.fusebox/
.dynamodb/
.tern-port
.yarn/install-state.gz
.pnp.*
.eslintcache
.stylelintcache
.npm
.yarn-integrity

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Diagnostic reports
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Stores VSCode versions used for testing VSCode extensions
.vscode-test

# ============================================
# Keep These Files
# ============================================
# Explicitly keep certain files that might match ignore patterns
!.gitkeep
!.env.example
!.prettierrc
!.eslintrc.js
!.nvmrc
!.editorconfig

