# ============================================
# DARK SOFTWARE FACTORY - ENVIRONMENT CONFIG
# ============================================
# Copy to .env: cp .env.example .env
# NEVER commit .env to version control
# ============================================

# ============================================
# DOCKER COMPOSE CONFIGURATION
# ============================================

# PostgreSQL Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_orchestrator
POSTGRES_PORT=5432

# RabbitMQ Message Queue
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_VHOST=/
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# Application
APP_PORT=3000

# Monitoring (Optional - only needed when running with --profile monitoring)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ============================================
# APPLICATION CONFIGURATION
# ============================================

# APPLICATION
NODE_ENV=development
PORT=3000

# CORS ORIGINS (comma-separated list of allowed origins)
# Development: Include frontend dev server and backend
# Production: Only include your production frontend URL
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# ============================================
# DOCKER CLIENT CONFIGURATION (Story 22.1)
# ============================================
# Path to Docker socket (default: /var/run/docker.sock)
# For DooD (Docker-outside-of-Docker) pattern
DOCKER_SOCKET_PATH=/var/run/docker.sock

# Connection retry configuration (optional)
DOCKER_CONNECTION_RETRY_ATTEMPTS=3
DOCKER_CONNECTION_RETRY_DELAY_MS=1000


# DATABASE (REQUIRED)
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}?schema=public"

# MESSAGE QUEUE (REQUIRED)
RABBITMQ_URL="amqp://${RABBITMQ_USER}:${RABBITMQ_PASS}@localhost:${RABBITMQ_PORT}"

# AUTHENTICATION (REQUIRED)
# Generate: openssl rand -base64 32
JWT_SECRET="REPLACE_ME_GENERATE_WITH_openssl_rand_base64_32"
JWT_EXPIRATION=3600
AUTH_SERVICE_URL="http://localhost:3001"

# USER INVITATIONS (Story 17.1)
FRONTEND_URL="http://localhost:5173"

# SEEDING (Optional)
ADMIN_PASSWORD="Admin123!"

# EMAIL CONFIGURATION (Story 17.1)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="user@example.com"
SMTP_PASS="password"
SMTP_FROM="noreply@darksoftwarefactory.com"

# GITHUB (for GitHub integration)
# Must start with: ghp_, ghs_, or github_pat_
# Note: When using GitHub App, GITHUB_TOKEN is still required
# for fallback authentication during MVP phase
GITHUB_TOKEN=""
# GitHub App - Better for Production
GITHUB_APP_ID=""
GITHUB_APP_PRIVATE_KEY=""
GITHUB_PRIVATE_KEY=""

# CLICKUP (for ticket integration)
CLICKUP_API_BASE_URL="https://api.clickup.com/api/v2"
CLICKUP_API_KEY=""

# CLICKUP SYNC MODE: Webhook vs Polling
# Set to true to use webhooks (requires ClickUp Business plan)
# Set to false to use polling (works with free/personal plans)
CLICKUP_USE_WEBHOOKS=false

# Webhook Configuration (only needed if CLICKUP_USE_WEBHOOKS=true)
# Generate: openssl rand -hex 16
CLICKUP_WEBHOOK_SECRET=""

# Polling Configuration (only needed if CLICKUP_USE_WEBHOOKS=false)

# Polling interval in milliseconds (default: 60000 = 1 minute)
CLICKUP_POLL_INTERVAL_MS=60000
# Maximum polling interval for backoff (default: 300000 = 5 minutes)
CLICKUP_MAX_POLL_INTERVAL_MS=300000

# Optional Settings
# Status names (customize based on your ClickUp workflow)
CLICKUP_STATUS_DEPLOYED="Deployed"
CLICKUP_STATUS_DEPLOY_FAILED="Deployment Failed"
CLICKUP_STATUS_ROLLED_BACK="Rolled Back"
# Retry settings
CLICKUP_RETRY_ATTEMPTS=3
CLICKUP_RETRY_BACKOFF_MS=1000
CLICKUP_MAX_COMMENT_LENGTH=20000

# ============================================
# GITHUB REPOSITORY MAPPING (REQUIRED)
# ============================================
# Default GitHub repository for AI code generation
# Used when ClickUp task doesn't specify a repository via custom field
GITHUB_DEFAULT_REPOSITORY="https://github.com/your-org/your-repo"

# Optional: Git configuration for commits
CURSOR_GIT_USER_NAME="Dark Factory Bot"
CURSOR_GIT_USER_EMAIL="bot@darkfactory.ai"

# AI PROVIDERS (at least ONE required for AI features)
CURSOR_HEADLESS_ENABLED=false
CLAUDE_CODE_ENABLED=false
CURSOR_API_KEY=""
WINDSURF_API_KEY=""
ANTHROPIC_API_KEY=""

# CURSOR CLI HEADLESS (Story 2.6)
# CURSOR_CLI_PATH is optional - defaults to 'cursor-agent' which should be in PATH after installation
# Only set this if you need to use a custom path: CURSOR_CLI_PATH="/custom/path/to/cursor-agent"
CURSOR_CLI_PATH="/Users/Alpharages/.local/bin/cursor-agent"

# CLAUDE_CLI_PATH is optional - defaults to 'claude' which should be in PATH after installation
# Useful for Docker deployments or non-standard installation locations
# CLAUDE_CLI_PATH="/usr/local/bin/claude"
# CLAUDE_CLI_PATH="/root/.local/bin/claude"
CURSOR_HEADLESS_TIMEOUT_MS=300000
CURSOR_WORKSPACES_ROOT="/tmp/cursor-workspaces"
CURSOR_MAX_CONCURRENT_WORKSPACES=10
CURSOR_PRESERVE_FAILED_WORKSPACES=true

# ANTHROPIC CLAUDE API (Story 2.7)
# Get API key from: https://console.anthropic.com/
ANTHROPIC_MODEL="claude-sonnet-4-20250514"
ANTHROPIC_MAX_TOKENS=8000
ANTHROPIC_TIMEOUT_MS=120000
CLAUDE_WORKSPACES_ROOT="/tmp/claude-workspaces"

# OPENAI API (Story 5.5 - Client Communication Intelligence)
# Required for Whisper transcription and GPT-4 analysis
# Get API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=""

# CLIENT CONVERSATIONS (Story 5.5)
# Storage path for uploaded audio files and transcripts
CONVERSATIONS_STORAGE_PATH="./storage/conversations"
# Maximum audio file size in MB (Whisper API limit is 25 MB)
MAX_AUDIO_FILE_SIZE_MB=25
# Audio file retention in days (automatic cleanup)
AUDIO_RETENTION_DAYS=90

# AETHERFLOW CLICKUP INTEGRATION (Story 5.5.1)
# Shared AetherFlow API for creating ClickUp tickets from conversation action items
# Base URL of AetherFlow service
AETHERFLOW_API_URL=\"http://localhost:3002\"
# Shared API key for DSF->AetherFlow authentication (min 32 chars)
# Generate: openssl rand -base64 32
AETHERFLOW_API_KEY=\"\"
# Optional default ClickUp list name for conversation-derived tickets
AETHERFLOW_DEFAULT_CLICKUP_LIST=\"Backlog\"



# AI DECISION AUDIT (Story 11.2)
# Threshold for triggering low-confidence alerts in Sentry (0.0 - 1.0)
# Decisions below this threshold are flagged for human review
AI_CONFIDENCE_THRESHOLD=0.5

# MONITORING (optional)
SENTRY_DSN=""
LOG_LEVEL="debug"

# Observability Dashboard (Story 14.5)
RABBITMQ_MANAGEMENT_URL="http://localhost:15672"
PROMETHEUS_URL="http://localhost:9090"

# COST TRACKING (optional)
DAILY_BUDGET_DEFAULT=100
COST_CAP_ENABLED=true

# RETRY CONFIGURATION (Story 2.9)
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_MS=1000
RETRY_BACKOFF_MULTIPLIER=2
RETRY_MAX_DELAY_MS=30000

# QUALITY SCORING (Story 2.11)
# Thresholds for quality grades (0-100)
QUALITY_SCORE_THRESHOLD_EXCELLENT=90
QUALITY_SCORE_THRESHOLD_GOOD=70
QUALITY_SCORE_THRESHOLD_FAIR=50
QUALITY_MINIMUM_THRESHOLD=50
# Cache TTL in seconds (60-3600)
QUALITY_SCORE_CACHE_TTL_SECONDS=300

# CONTEXT EXTRACTION (Story 2.12)
# FR3: PM can attach context documents
# FR59: System extracts project context
CONTEXT_MAX_FILE_SIZE_MB=10
CONTEXT_CACHE_TTL_HOURS=24
CONTEXT_STORAGE_PATH="./uploads/context"
CONTEXT_SUPPORTED_FORMATS="pdf,md,txt,docx"

# QA RESULTS STORAGE (Story 3.6)
# FR38: Lead QA can view automated QA results
QA_RESULTS_DEFAULT_PAGE_SIZE=20
QA_RESULTS_MAX_PAGE_SIZE=100

# QA QUEUE PROCESSING (Story 3.7)
# RabbitMQ QA Check Queue Configuration
QA_CHECK_CONCURRENCY=5
QA_CHECK_MAX_RETRIES=3
QA_CHECK_TIMEOUT_MS=300000
QA_QUEUE_DEPTH_INTERVAL_MS=30000

# SELF-HEALING (Story 13.4)
# Enable/disable AI self-healing for QA failures
SELF_HEALING_ENABLED=true

# ============================================
# SANDBOX RESOURCE LIMIT ENFORCEMENT (Story 23.3)
# ============================================
# Master switch to enable/disable resource limits for sandbox containers
SANDBOX_ENABLE_RESOURCE_LIMITS=true

# Memory limit per container in MB (default: 512MB)
# Limits the maximum RAM each AI agent container can use
SANDBOX_MEMORY_LIMIT_MB=512

# CPU limit as percentage of single core (default: 100% = 1 core)
# 100 = 1 core, 200 = 2 cores, 50 = 0.5 cores
SANDBOX_CPU_LIMIT_PERCENT=100

# Swap limit per container in MB (default: 512MB, 0 to disable swap)
# Setting to 0 prevents containers from using swap (strict memory limits)
SANDBOX_MEMORY_SWAP_LIMIT_MB=512

# Resource Profile Selection
# Containers can use predefined profiles: small, medium, large, custom
# small:  256MB RAM, 50% CPU  - For simple tasks (linting, small fixes)
# medium: 512MB RAM, 100% CPU - For standard tasks (default)
# large:  1024MB RAM, 200% CPU - For complex tasks (large refactors, builds)
