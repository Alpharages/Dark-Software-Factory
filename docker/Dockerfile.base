# ===========================================
# Dark Software Factory — Agent Base Image
# ===========================================
# Purpose: Extends OpenSandbox code-interpreter with AI provider CLIs
# Base: opensandbox/code-interpreter:v1.0.2 (Ubuntu 24.04, Node 20/22, Python 3.10-3.14, Go, Java, uv)
#
# Pre-installed AI CLIs: Claude Code, Cursor, Kimi
# Pre-installed tools: git, python3, node, go, java, pnpm, yarn, composer
#
# Build (from repo root):
#   docker build -f docker/Dockerfile.base -t dsf-agents-base:latest .
# ===========================================

FROM opensandbox/code-interpreter:v1.0.2

USER root

# ============================================
# Additional System Dependencies
# ============================================
RUN apt-get update && apt-get install -y --no-install-recommends \
    php-cli \
    sudo \
    && rm -rf /var/lib/apt/lists/*

# Composer (PHP/Laravel support)
RUN curl -sS https://getcomposer.org/installer | php -- --install-dir=/usr/local/bin --filename=composer

# ============================================
# AI Provider CLIs (as root)
# ============================================

# Cursor CLI
RUN curl https://cursor.com/install -fsS | bash && \
    export PATH="/root/.local/bin:$PATH" && \
    if [ -f "/root/.local/bin/agent" ]; then \
      cp /root/.local/bin/agent /usr/local/bin/agent && chmod 755 /usr/local/bin/agent; \
    elif [ -f "$HOME/.cursor/bin/agent" ]; then \
      cp "$HOME/.cursor/bin/agent" /usr/local/bin/agent && chmod 755 /usr/local/bin/agent; \
    else \
      AGENT_PATH=$(find /root -name "agent" -type f -executable 2>/dev/null | head -1); \
      if [ -n "$AGENT_PATH" ]; then cp "$AGENT_PATH" /usr/local/bin/agent && chmod 755 /usr/local/bin/agent; fi; \
    fi

# Claude Code CLI
RUN npm install -g @anthropic-ai/claude-code && \
    which claude && chmod +x $(which claude)

# ============================================
# Package Managers (as root)
# ============================================
RUN npm install -g --force pnpm yarn && \
    pnpm --version && yarn --version

# Verify root-installed CLIs
RUN which agent || (echo "Cursor CLI installation failed" && exit 1)
RUN which claude || (echo "Claude CLI installation failed" && exit 1)

# ============================================
# Non-root Agent User
# ============================================
# code-interpreter ships with 'ubuntu' (UID 1000) — rename to 'agent' for consistency
RUN usermod -l agent -d /home/agent -m ubuntu 2>/dev/null || true && \
    groupmod -n agent ubuntu 2>/dev/null || true
RUN echo "agent ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/agent && \
    chmod 0440 /etc/sudoers.d/agent

WORKDIR /home/agent
RUN mkdir -p /home/agent/workspace && chown -R agent:agent /home/agent/workspace

# ============================================
# Agent-user CLIs (must run as agent for correct shebang paths)
# ============================================
USER agent
ENV PATH="/home/agent/.local/bin:$PATH"

# Kimi CLI (uv is already available from code-interpreter base)
RUN uv tool install --python 3.13 kimi-cli && \
    which kimi

# ============================================
# Final Verification
# ============================================
RUN node -v && npm -v && python3 --version && git --version && \
    which agent && claude --version && which kimi
