# ===========================================
# Dark Software Factory — Agent Sandbox Image
# ===========================================
# Purpose: Extends the base agent image with the dsf-execution Claude Code skill
# Bundled skill: docker/skills/dsf-execution/SKILL.md
#   → /home/agent/.claude/skills/dsf-execution/SKILL.md
#
# Build (from repo root):
#   docker build -f docker/Dockerfile.agents -t dsf-agents:latest .
#
# Required by: ClaudeCodeProvider (WR-2.3)
# Security review: docker/skills/dsf-execution/SECURITY-REVIEW.md (NFR-WR6)
# ===========================================

FROM dsf-agents-base:latest

# Switch to root to install skill files with correct ownership
USER root

# Install GitHub CLI (required for `gh pr create` in the dsf-execution skill)
# Dockerfile.base does not include gh — must be installed here
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg | \
    dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" | \
    tee /etc/apt/sources.list.d/github-cli.list > /dev/null && \
    apt-get update && apt-get install -y gh && \
    rm -rf /var/lib/apt/lists/*

# Create skills directories for all CLIs (Claude, Codex, Gemini, Kimi)
RUN mkdir -p /home/agent/.claude/skills/dsf-execution \
             /home/agent/.codex/skills/dsf-execution \
             /home/agent/.gemini/skills/dsf-execution \
             /home/agent/.kimi/skills/dsf-execution && \
    chown -R agent:agent /home/agent/.claude /home/agent/.codex /home/agent/.gemini /home/agent/.kimi

# Bundle the dsf-execution skill (source: docker/skills/dsf-execution/SKILL.md)
# Universal skill: the same core content works across all agentic CLIs
COPY --chown=agent:agent docker/skills/dsf-execution/SKILL.md /home/agent/.claude/skills/dsf-execution/SKILL.md
COPY --chown=agent:agent docker/skills/dsf-execution/SKILL.md /home/agent/.codex/skills/dsf-execution/SKILL.md
COPY --chown=agent:agent docker/skills/dsf-execution/SKILL.md /home/agent/.gemini/skills/dsf-execution/SKILL.md
COPY --chown=agent:agent docker/skills/dsf-execution/SKILL.md /home/agent/.kimi/skills/dsf-execution/SKILL.md

# Set permissions for all skill files
RUN chmod 644 /home/agent/.claude/skills/dsf-execution/SKILL.md \
              /home/agent/.codex/skills/dsf-execution/SKILL.md \
              /home/agent/.gemini/skills/dsf-execution/SKILL.md \
              /home/agent/.kimi/skills/dsf-execution/SKILL.md

# Switch back to non-root agent user
USER agent

# Verify skill files are accessible
RUN test -f /home/agent/.claude/skills/dsf-execution/SKILL.md && \
    test -f /home/agent/.codex/skills/dsf-execution/SKILL.md && \
    test -f /home/agent/.gemini/skills/dsf-execution/SKILL.md && \
    test -f /home/agent/.kimi/skills/dsf-execution/SKILL.md && \
    echo "All dsf-execution skills bundled successfully"
