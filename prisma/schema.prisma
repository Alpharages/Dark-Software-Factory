generator client {
  provider = "prisma-client"
  output   = "../src/prisma"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id                    String                 @id @default(uuid())
  name                  String
  clickup_list_id       String?                @unique
  github_repository_url String
  default_branch        String                 @default("main")
  budget_usd            Decimal?               @default(100.00) @db.Decimal(10, 2)
  created_at            DateTime               @default(now())
  updated_at            DateTime               @updatedAt
  pm_id                 String
  status                String                 @default("active")
  client_name           String                 @default("Internal")
  monitor_tasks         Boolean                @default(false)
  provider              ProjectProvider        @default(CLICKUP)
  sync_config           Json?
  deactivated_at        DateTime?
  is_active             Boolean                @default(true)
  conversations         ClientConversation[]
  coverage_baseline     CoverageBaseline?
  coverage_config       ProjectCoverageConfig?
  quality_gate_config   QualityGateConfig?
  reports               Report[]
  tickets               Ticket[]

  @@map("projects")
}

model Ticket {
  id                   String               @id @default(uuid())
  clickup_task_id      String               @unique
  project_id           String
  title                String
  description          String
  acceptance_criteria  String
  ticket_quality_score Int
  status               TicketStatus         @default(RECEIVED)
  created_at           DateTime             @default(now())
  updated_at           DateTime             @updatedAt
  conversation_id      String?
  adrs                 Adr[]
  ai_cost_logs         AICostLog[]
  bug_escapes          BugEscape[]
  context_documents    ContextDocument[]
  cost_records         CostRecord[]
  executions           Execution[]
  production_approvals ProductionApproval[]
  conversation         ClientConversation?  @relation("ConversationTickets", fields: [conversation_id], references: [id])
  project              Project              @relation(fields: [project_id], references: [id])

  @@index([project_id, status])
  @@index([created_at])
  @@index([clickup_task_id])
  @@index([title])
  @@map("tickets")
}

model Execution {
  id                    String            @id @default(uuid())
  ticket_id             String
  ai_provider           AIProvider
  prompt                String
  status                ExecutionStatus   @default(QUEUED)
  confidence_score      Float?
  started_at            DateTime?
  completed_at          DateTime?
  failed_at             DateTime?
  error_message         String?
  code_output           String?
  files_changed         Json?
  retry_count           Int               @default(0)
  max_retries           Int               @default(3)
  created_at            DateTime          @default(now())
  updated_at            DateTime          @updatedAt
  complexity_breakdown  Json?
  complexity_score      Int?
  error_context         String?
  fallback_used         Boolean           @default(false)
  original_provider     AIProvider?
  routing_reason        String?
  scheduled_retry_at    DateTime?
  base_branch           String?
  branch_selection_log  String?
  circular_dep_detected Boolean           @default(false)
  file_modifications    Json?
  risk_level            PRRiskLevel?
  selected_model        String?
  task_type             TaskType?
  container_id          String?
  debug_mode            Boolean           @default(false)
  adrs                  Adr[]
  aiCostLogs            AICostLog[]
  aiDecisionLogs        AIDecisionLog[]
  approvalRecords       ApprovalRecord[]
  bug_escapes           BugEscape[]
  ticket                Ticket            @relation(fields: [ticket_id], references: [id])
  fileLockQueueEntries  FileLockQueue[]
  fileLocks             FileLock[]
  qa_result             QAResult?
  qa_review_queue       QaReviewQueue?
  archive               WorkspaceArchive?

  @@index([ticket_id, status])
  @@index([ai_provider, status])
  @@index([scheduled_retry_at])
  @@map("executions")
}

model QAResult {
  id                 String      @id @default(uuid())
  execution_id       String      @unique
  linting_passed     Boolean     @default(false)
  linting_errors     Json?
  tests_passed       Boolean     @default(false)
  test_results       Json?
  test_coverage      Float?
  code_review_passed Boolean     @default(false)
  code_review_issues Json?
  overall_passed     Boolean     @default(false)
  created_at         DateTime    @default(now())
  updated_at         DateTime    @updatedAt
  bug_escapes        BugEscape[]
  execution          Execution   @relation(fields: [execution_id], references: [id], onDelete: Cascade)

  @@index([overall_passed, created_at])
  @@map("qa_results")
}

model GitHubInstallation {
  id              String    @id @default(uuid())
  installation_id String    @unique @map("installation_id")
  account_login   String    @map("account_login")
  account_id      String    @map("account_id")
  account_type    String    @map("account_type")
  access_token    String?
  expires_at      DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  @@index([account_login])
  @@map("github_installations")
}

model GitHubPush {
  id            String       @id @default(uuid())
  execution_id  String
  repository    String
  branch_name   String
  commit_sha    String?
  pr_number     Int?
  pr_url        String?
  push_status   GitHubStatus @default(PENDING)
  error_message String?
  created_at    DateTime     @default(now())
  updated_at    DateTime     @updatedAt
  deployments   Deployment[]

  @@map("github_pushes")
}

model Deployment {
  id             String           @id @default(uuid())
  github_push_id String
  environment    String
  cicd_provider  String
  build_id       String?
  status         DeploymentStatus @default(TRIGGERED)
  deployed_at    DateTime?
  created_at     DateTime         @default(now())
  updated_at     DateTime         @updatedAt
  error_message  String?
  workflow_id    String?
  github_push    GitHubPush       @relation(fields: [github_push_id], references: [id])

  @@index([github_push_id])
  @@index([status, environment])
  @@map("deployments")
}

model CostRecord {
  id             String     @id @default(uuid())
  ticket_id      String
  ai_provider    AIProvider
  operation_type String
  tokens_used    Int?
  api_calls      Int        @default(1)
  cost_in_cents  Int
  created_at     DateTime   @default(now())
  ticket         Ticket     @relation(fields: [ticket_id], references: [id])

  @@index([ticket_id])
  @@index([ai_provider, created_at])
  @@map("cost_records")
}

model ProductionError {
  id            String        @id @default(uuid())
  application   String
  error_type    String
  error_message String
  stack_trace   String?
  severity      ErrorSeverity
  fix_ticket_id String?
  resolved      Boolean       @default(false)
  occurred_at   DateTime
  created_at    DateTime      @default(now())
  bug_escape    BugEscape?

  @@index([application, severity, resolved])
  @@map("production_errors")
}

model Metric {
  id          String   @id @default(uuid())
  metric_name String
  metric_type String
  value       Float
  labels      Json?
  recorded_at DateTime @default(now())

  @@index([metric_name, recorded_at])
  @@map("metrics")
}

model AuditLog {
  id           String   @id @default(uuid())
  entity_type  String
  entity_id    String
  action       String
  actor_type   String
  actor_id     String?
  before_state Json?
  after_state  Json?
  created_at   DateTime @default(now())

  @@index([entity_type, entity_id])
  @@index([created_at])
  @@map("audit_logs")
}

model ContextDocument {
  id                String            @id @default(uuid())
  ticket_id         String
  original_filename String
  file_format       ContextFileFormat
  file_size_bytes   Int
  file_hash         String            @unique
  storage_path      String
  extracted_text    String
  extraction_status ExtractionStatus  @default(PENDING)
  extraction_error  String?
  document_title    String?
  document_type     String?
  content_summary   String?
  content_hash      String?
  cached_at         DateTime?
  cache_expires_at  DateTime?
  created_at        DateTime          @default(now())
  updated_at        DateTime          @updatedAt
  ticket            Ticket            @relation(fields: [ticket_id], references: [id], onDelete: Cascade)

  @@index([ticket_id])
  @@index([file_hash])
  @@index([extraction_status])
  @@map("context_documents")
}

model CoverageBaseline {
  id         String   @id @default(uuid())
  project_id String   @unique
  branch     String   @default("main")
  lines      Float
  branches   Float
  functions  Float
  statements Float
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  project    Project  @relation(fields: [project_id], references: [id])

  @@unique([project_id, branch])
  @@index([project_id])
  @@map("coverage_baselines")
}

model ProjectCoverageConfig {
  id          String   @id @default(uuid())
  project_id  String   @unique
  threshold   Float    @default(80)
  enforcement Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  project     Project  @relation(fields: [project_id], references: [id])

  @@map("project_coverage_configs")
}

model WebhookEvent {
  id           String   @id
  source       String
  event_type   String
  payload      Json
  processed_at DateTime @default(now())

  @@index([source, event_type, processed_at])
  @@map("webhook_events")
}

model Workspace {
  id             String          @id @default(uuid())
  workspace_id   String          @unique
  execution_id   String          @unique
  ticket_id      String
  workspace_path String
  repository_url String?
  branch_name    String
  status         WorkspaceStatus @default(CREATING)
  created_at     DateTime        @default(now())
  updated_at     DateTime        @updatedAt
  cleaned_at     DateTime?

  @@index([execution_id])
  @@index([ticket_id])
  @@index([status, created_at])
  @@map("workspaces")
}

model AIDecisionLog {
  id           String     @id @default(uuid())
  timestamp    DateTime   @default(now())
  agent_name   String
  action       String
  reasoning    String
  ticket_id    String
  execution_id String?
  input_data   Json
  output_data  Json
  confidence   Float
  execution    Execution? @relation(fields: [execution_id], references: [id])

  @@index([ticket_id, timestamp])
  @@index([execution_id])
  @@index([agent_name])
  @@index([timestamp])
  @@index([confidence, timestamp])
  @@map("ai_decision_logs")
}

model FileLock {
  id           String         @id @default(uuid())
  ticket_id    String
  execution_id String
  file_path    String
  locked_at    DateTime       @default(now())
  released_at  DateTime?
  status       FileLockStatus @default(LOCKED)
  execution    Execution      @relation(fields: [execution_id], references: [id], onDelete: Cascade)

  @@unique([ticket_id, file_path])
  @@index([execution_id])
  @@index([status])
  @@index([ticket_id])
  @@map("file_locks")
}

model FileLockQueue {
  id           String              @id @default(uuid())
  ticket_id    String
  execution_id String
  file_path    String
  requested_at DateTime            @default(now())
  acquired_at  DateTime?
  status       FileLockQueueStatus @default(WAITING)
  execution    Execution           @relation(fields: [execution_id], references: [id], onDelete: Cascade)

  @@unique([ticket_id, execution_id, file_path])
  @@index([file_path, status, requested_at])
  @@index([ticket_id])
  @@index([execution_id])
  @@map("file_lock_queue")
}

model AICostLog {
  id             String     @id @default(uuid())
  execution_id   String?
  ticket_id      String?
  timestamp      DateTime   @default(now())
  ai_provider    AIProvider
  model_name     String
  operation_type String
  tokens_input   Int?
  tokens_output  Int?
  tokens_total   Int?
  cost_usd       Decimal    @db.Decimal(10, 6)
  execution      Execution? @relation(fields: [execution_id], references: [id])
  ticket         Ticket?    @relation(fields: [ticket_id], references: [id])

  @@index([execution_id])
  @@index([ticket_id, timestamp])
  @@index([ai_provider, timestamp])
  @@map("ai_cost_logs")
}

model TicketDependency {
  id                String           @id @default(uuid())
  ticket_id         String
  depends_on        String
  status            DependencyStatus @default(WAITING)
  circular_detected Boolean          @default(false)
  created_at        DateTime         @default(now())
  resolved_at       DateTime?
  estimated_eta     DateTime?
  eta_calculated_at DateTime?

  @@unique([ticket_id, depends_on])
  @@index([ticket_id])
  @@index([depends_on])
  @@index([status])
  @@map("ticket_dependencies")
}

model WorkspaceArchive {
  id              String        @id @default(uuid())
  execution_id    String        @unique
  workspace_path  String
  archive_path    String?
  size_bytes      BigInt
  compressed_size BigInt?
  status          ArchiveStatus @default(PENDING)
  archived_at     DateTime?
  error_message   String?
  execution       Execution     @relation(fields: [execution_id], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([archived_at])
  @@map("workspace_archives")
}

model ApprovalRecord {
  id           String           @id @default(uuid())
  execution_id String
  pm_id        String
  decision     ApprovalDecision
  reasoning    String?
  created_at   DateTime         @default(now())
  execution    Execution        @relation(fields: [execution_id], references: [id], onDelete: Cascade)

  @@index([execution_id])
  @@map("approval_records")
}

model ProductionApproval {
  id              String           @id @default(uuid())
  ticket_id       String
  approver_id     String
  decision        ApprovalDecision
  override_reason String?
  created_at      DateTime         @default(now())
  ticket          Ticket           @relation(fields: [ticket_id], references: [id])

  @@index([ticket_id])
  @@index([approver_id])
  @@map("production_approvals")
}

model BugEscape {
  id                    String          @id @default(uuid())
  production_error_id   String          @unique
  ticket_id             String
  execution_id          String?
  qa_result_id          String?
  qa_review_queue_id    String?
  escape_category       EscapeCategory
  severity_at_detection ErrorSeverity
  detected_at           DateTime
  resolved_at           DateTime?
  resolution_time_hours Float?
  project_id            String
  ai_provider           String?
  complexity_score      Int?
  created_at            DateTime        @default(now())
  execution             Execution?      @relation(fields: [execution_id], references: [id])
  production_error      ProductionError @relation(fields: [production_error_id], references: [id])
  qa_result             QAResult?       @relation(fields: [qa_result_id], references: [id])
  qa_review_queue       QaReviewQueue?  @relation(fields: [qa_review_queue_id], references: [id])
  ticket                Ticket          @relation(fields: [ticket_id], references: [id])

  @@index([project_id, detected_at])
  @@index([detected_at])
  @@index([escape_category])
  @@index([ai_provider, detected_at])
  @@map("bug_escapes")
}

model AiCodeReview {
  id                     String                @id @default(uuid())
  queue_item_id          String
  review_version         Int                   @default(1)
  generated_at           DateTime              @default(now())
  ai_model               String
  confidence_score       Decimal               @db.Decimal(3, 2)
  overall_assessment     String
  summary                String
  findings               Json
  generation_duration_ms Int
  token_usage            Json?
  cost_usd               Decimal?              @db.Decimal(10, 6)
  cache_key              String?               @unique
  expires_at             DateTime?
  created_at             DateTime              @default(now())
  updated_at             DateTime              @updatedAt
  finding_statuses       AiCodeReviewFinding[]
  queue_item             QaReviewQueue         @relation(fields: [queue_item_id], references: [id])

  @@unique([queue_item_id, review_version])
  @@index([queue_item_id])
  @@index([generated_at])
  @@index([cache_key])
  @@map("ai_code_reviews")
}

model AiCodeReviewFinding {
  id           String       @id @default(uuid())
  ai_review_id String
  finding_key  String
  finding_type String
  severity     String
  file_path    String?
  line_number  Int?
  description  String
  suggestion   String?
  status       String       @default("PENDING")
  reviewed_by  String?
  reviewed_at  DateTime?
  review_notes String?
  created_at   DateTime     @default(now())
  updated_at   DateTime     @updatedAt
  ai_review    AiCodeReview @relation(fields: [ai_review_id], references: [id], onDelete: Cascade)

  @@index([ai_review_id])
  @@index([status])
  @@index([finding_key])
  @@map("ai_code_review_findings")
}

model User {
  id                           String                     @id
  email                        String                     @unique
  role                         String                     @default("PM")
  managed_by_id                String?
  max_tickets                  Int                        @default(20)
  created_at                   DateTime                   @default(now())
  updated_at                   DateTime                   @updatedAt
  full_name                    String
  is_active                    Boolean                    @default(true)
  last_login_at                DateTime?
  password_hash                String
  conversations                ClientConversation[]       @relation("PMConversations")
  quality_gate_history         QualityGateConfigHistory[]
  quality_gate_configs_created QualityGateConfig[]        @relation("QualityGateConfigCreatedBy")
  quality_gate_configs_updated QualityGateConfig[]        @relation("QualityGateConfigUpdatedBy")
  refreshTokens                RefreshToken[]
  invitations                  UserInvitation[]           @relation("InvitedBy")
  manager                      User?                      @relation("ManagerTeam", fields: [managed_by_id], references: [id])
  team_members                 User[]                     @relation("ManagerTeam")
  utilization_history          UtilizationHistory[]

  @@index([managed_by_id])
  @@index([role])
  @@index([email])
  @@map("users")
}

model UtilizationHistory {
  id              String   @id @default(uuid())
  pm_id           String
  snapshot_date   DateTime @default(now()) @db.Date
  active_tickets  Int
  max_tickets     Int
  utilization_pct Float
  created_at      DateTime @default(now())
  pm              User     @relation(fields: [pm_id], references: [id], onDelete: Cascade)

  @@unique([pm_id, snapshot_date])
  @@index([pm_id, snapshot_date])
  @@index([snapshot_date])
  @@map("utilization_history")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model ClientConversation {
  id                String   @id @default(uuid())
  project_id        String
  pm_id             String
  conversation_date DateTime
  title             String
  transcript        String
  summary           String?
  action_items      Json[]
  sentiment         String?
  audio_file_url    String?
  status            String   @default("uploaded")
  processing_cost   Float?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
  clickup_task_ids  Json?
  pm                User     @relation("PMConversations", fields: [pm_id], references: [id])
  project           Project  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  linked_tickets    Ticket[] @relation("ConversationTickets")

  @@index([project_id, conversation_date])
  @@index([sentiment])
  @@index([status])
  @@map("client_conversations")
}

model Report {
  id         String       @id @default(uuid())
  project_id String
  type       ReportType   @default(SPRINT)
  status     ReportStatus @default(PENDING)
  title      String
  date_start DateTime
  date_end   DateTime
  raw_data   Json?
  summary    String?
  narrative  String?
  insights   String?
  file_urls  Json?
  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt
  project    Project      @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([project_id, date_start, date_end])
  @@map("reports")
}

model SystemConfig {
  key         String   @id
  value       String
  description String?
  is_secret   Boolean  @default(false)
  updated_by  String?
  updated_at  DateTime @updatedAt

  @@map("system_configs")
}

model Adr {
  id                          String     @id @default(uuid())
  execution_id                String?
  ticket_id                   String?
  title                       String
  status                      AdrStatus  @default(PROPOSED)
  context                     String
  decision                    String
  consequences                String
  alternatives                String?
  ai_confidence               Float?
  risk_level                  RiskLevel?
  created_at                  DateTime   @default(now())
  updated_at                  DateTime   @updatedAt
  risk_factors                Json?
  delegate_to                 String?
  escalation_questions        Json?
  escalation_reason           String?
  guidance_provided_at        DateTime?
  tl_guidance                 String?
  trade_offs                  Json?
  rejection_reason            String?
  resolving_execution_id      String?
  review_duration_seconds     Int?
  reviewed_at                 DateTime?
  escalation_duration_seconds Int?
  execution                   Execution? @relation(fields: [execution_id], references: [id])
  ticket                      Ticket?    @relation(fields: [ticket_id], references: [id])

  @@index([execution_id])
  @@index([ticket_id])
  @@index([status])
  @@map("adrs")
}

model AdrAlert {
  id           String   @id @default(uuid())
  alert_type   String
  triggered_at DateTime @default(now())
  metadata     Json?

  @@index([alert_type, triggered_at])
  @@map("adr_alerts")
}

model QaSamplingConfig {
  id                 String   @id @default(uuid())
  percentage         Decimal  @default(20.0) @db.Decimal(5, 2)
  risk_based_enabled Boolean  @default(true)
  risk_rules         Json
  random_seed        String?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  @@map("qa_sampling_config")
}

model QaReviewQueue {
  id                String           @id @default(uuid())
  ticket_id         String
  execution_id      String           @unique
  project_id        String?
  pr_id             String?
  pr_url            String?
  status            QaReviewStatus   @default(PENDING)
  risk_level        RiskLevel
  risk_factors      Json
  sampling_strategy SamplingStrategy
  reviewed_by       String?
  reviewed_at       DateTime?
  review_notes      String?
  created_at        DateTime         @default(now())
  updated_at        DateTime         @updatedAt
  ai_code_reviews   AiCodeReview[]
  bug_escapes       BugEscape[]
  execution         Execution        @relation(fields: [execution_id], references: [id])

  @@index([status, created_at])
  @@index([risk_level, created_at])
  @@index([project_id, status])
  @@index([execution_id])
  @@index([reviewed_by, reviewed_at])
  @@map("qa_review_queue")
}

model ArchitectureConstraint {
  id        String   @id @default(uuid())
  projectId String?
  scope     String
  type      String
  rules     Json
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("architecture_constraints")
}

model AiCapability {
  id            String   @id @default(uuid())
  task_type     TaskType @unique
  success_count Int      @default(0)
  failure_count Int      @default(0)
  known_issues  String?
  workaround    String?
  is_disabled   Boolean  @default(false)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@map("ai_capabilities")
}

model AiTaskPattern {
  id                String   @id @default(uuid())
  pattern_signature String
  task_type         TaskType
  failure_rate      Float
  detected_at       DateTime @default(now())
  example_ids       Json
  updated_at        DateTime @updatedAt

  @@index([task_type, failure_rate])
  @@map("ai_task_patterns")
}

model UserInvitation {
  id            String           @id @default(uuid())
  email         String
  role          String
  invite_token  String           @unique
  invited_by_id String
  status        InvitationStatus @default(PENDING)
  expires_at    DateTime
  accepted_at   DateTime?
  created_at    DateTime         @default(now())
  invited_by    User             @relation("InvitedBy", fields: [invited_by_id], references: [id])

  @@index([email])
  @@index([invite_token])
  @@index([status])
  @@index([email, status])
  @@map("user_invitations")
}

model RefreshToken {
  id         String   @id @default(uuid())
  token_id   String   @unique
  user_id    String
  is_revoked Boolean  @default(false)
  expires_at DateTime
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([token_id])
  @@index([user_id, is_revoked])
  @@map("refresh_tokens")
}

model QualityGateConfig {
  id                       String                     @id @default(uuid())
  projectId                String?                    @unique
  minTestPassRate          Int                        @default(100)
  minCoverage              Int                        @default(80)
  maxLintingErrors         Int                        @default(0)
  maxLintingWarnings       Int                        @default(10)
  blockOnCriticalSecurity  Boolean                    @default(true)
  blockOnHighSecurity      Boolean                    @default(true)
  maxComplexity            Int                        @default(20)
  targetCoverage           Int                        @default(90)
  enabledCategories        Json                       @default("[\"LINTING\", \"TESTING\", \"COVERAGE\", \"SECURITY\"]")
  allowOverride            Boolean                    @default(false)
  overrideRequiresApproval Boolean                    @default(true)
  version                  Int                        @default(1)
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  createdById              String
  updatedById              String
  history                  QualityGateConfigHistory[]
  createdBy                User                       @relation("QualityGateConfigCreatedBy", fields: [createdById], references: [id])
  project                  Project?                   @relation(fields: [projectId], references: [id])
  updatedBy                User                       @relation("QualityGateConfigUpdatedBy", fields: [updatedById], references: [id])

  @@index([projectId])
  @@map("quality_gate_configs")
}

model QualityGateConfigHistory {
  id           String            @id @default(uuid())
  configId     String
  projectId    String?
  snapshot     Json
  version      Int
  changedById  String
  changedAt    DateTime          @default(now())
  changeReason String?
  changedBy    User              @relation(fields: [changedById], references: [id])
  config       QualityGateConfig @relation(fields: [configId], references: [id])

  @@index([configId])
  @@index([projectId])
  @@index([changedAt])
  @@map("quality_gate_config_history")
}

model QualityAnomaly {
  id               String    @id @default(uuid())
  type             String
  metric           String
  severity         String
  project_id       String
  detected_at      DateTime  @default(now())
  current_value    Float
  previous_value   Float?
  expected_min     Float?
  expected_max     Float?
  change_percent   Float?
  ai_analysis      Json?
  status           String    @default("open")
  resolved_at      DateTime?
  resolved_by      String?
  resolution_notes String?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  @@index([project_id])
  @@index([status])
  @@index([detected_at])
  @@index([severity])
  @@map("quality_anomalies")
}

model QualityAnomalyConfig {
  id                    String   @id @default(uuid())
  project_id            String?  @unique
  thresholds            Json
  notifications_enabled Boolean  @default(true)
  slack_channels        String[]
  email_recipients      String[]
  updated_at            DateTime @updatedAt
  updated_by            String?

  @@map("quality_anomaly_configs")
}

