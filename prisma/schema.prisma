generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id                        String                  @id @default(uuid())
  name                      String
  clickup_list_id           String?                 @unique
  github_repository_url     String
  default_branch            String                  @default("main")
  budget_usd                Decimal?                @default(100.00) @db.Decimal(10, 2)
  created_at                DateTime                @default(now())
  updated_at                DateTime                @updatedAt
  pm_id                     String
  status                    String                  @default("active")
  client_name               String                  @default("Internal")
  monitor_tasks             Boolean                 @default(false)
  provider                  PMProvider              @default(CLICKUP)
  sync_config               Json?
  deactivated_at            DateTime?
  is_active                 Boolean                 @default(true)
  qa_failure_status         String? // WR-4.2: ClickUp status name for QA exhaustion (FR-WR11)
  manual_review_status      String? // WR-4.2: ClickUp status name for PM cancel action (FR-WR11, WR-4.3)
  code_review_status        String? // WR-4.2: ClickUp status name after open_pr action (FR-WR11, WR-4.3)
  qa_max_retries            Int                     @default(3) // WR-5.1: Per-project QA retry limit (FR-EXT1, NFR-EXT1/2)
  max_execution_retries     Int                     @default(3) // Per-project execution-level retry limit
  require_pr_approval       Boolean? // Null = inherit global GITHUB_REQUIRE_PR_APPROVAL; set = per-project override of the PR-open approval gate
  dependency_block_behavior DependencyBlockBehavior @default(auto_resume)
  conversations             ClientConversation[]
  coverage_baseline         CoverageBaseline?
  coverage_config           ProjectCoverageConfig?
  quality_gate_config       QualityGateConfig?
  reports                   Report[]
  tickets                   Ticket[]
  github_account_id         String?                 @map("github_account_id")
  gitHubAccount             GitHubAccount?          @relation(fields: [github_account_id], references: [id], onDelete: SetNull)
  integrations              ProjectIntegration[]
  status_skill_maps         ProjectStatusSkillMap[]

  @@index([github_account_id])
  @@map("projects")
}

model ProjectStatusSkillMap {
  id                String   @id @default(uuid())
  project_id        String
  status            String
  normalized_status String
  skill             String
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
  project           Project  @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@unique([project_id, normalized_status])
  @@index([project_id])
  @@map("project_status_skill_maps")
}

model SkillModelMap {
  id         String   @id @default(uuid())
  skill      String   @unique // validated against OpenHarnessSkill at write time
  model      String // e.g. 'gpt-5.4' (oh) or 'opus'/'sonnet' (claude)
  provider   String // 'openai' | 'claude'
  runtime    String // 'oh' | 'claude'
  updated_by String?
  updated_at DateTime @updatedAt
  created_at DateTime @default(now())

  @@map("skill_model_maps")
}

model Ticket {
  id                        String                   @id @default(uuid())
  clickup_task_id           String                   @unique
  project_id                String
  title                     String
  description               String
  acceptance_criteria       String
  ticket_quality_score      Int
  epic_num                  String?
  completion_date           DateTime?
  pm_synced                 Boolean                  @default(true)
  status                    TicketStatus             @default(RECEIVED)
  created_at                DateTime                 @default(now())
  updated_at                DateTime                 @updatedAt
  conversation_id           String?
  dependency_block_behavior DependencyBlockBehavior?
  adrs                      Adr[]
  ai_cost_logs              AICostLog[]
  bug_escapes               BugEscape[]
  context_documents         ContextDocument[]
  cost_records              CostRecord[]
  executions                Execution[]
  production_approvals      ProductionApproval[]
  conversation              ClientConversation?      @relation("ConversationTickets", fields: [conversation_id], references: [id])
  project                   Project                  @relation(fields: [project_id], references: [id])

  @@index([project_id, status])
  @@index([created_at])
  @@index([clickup_task_id])
  @@index([title])
  @@map("tickets")
}

model Execution {
  id                    String              @id @default(uuid())
  ticket_id             String
  ai_provider           AIProvider
  prompt                String
  status                ExecutionStatus     @default(QUEUED)
  confidence_score      Float?
  started_at            DateTime?
  completed_at          DateTime?
  failed_at             DateTime?
  error_message         String?
  code_output           String?
  files_changed         Json?
  retry_count           Int                 @default(0)
  max_retries           Int                 @default(3)
  created_at            DateTime            @default(now())
  updated_at            DateTime            @updatedAt
  complexity_breakdown  Json?
  complexity_score      Int?
  error_context         String?
  fallback_used         Boolean             @default(false)
  original_provider     AIProvider?
  routing_reason        String?
  scheduled_retry_at    DateTime?
  base_branch           String?
  qa_failed_branch      String? // WR-4.1: branch pushed when QA exhausted retries
  branch_selection_log  String?
  circular_dep_detected Boolean             @default(false)
  file_modifications    Json?
  risk_level            PRRiskLevel?
  selected_model        String?
  selected_account_id   String?
  task_type             TaskType?
  container_id          String?
  debug_mode            Boolean             @default(false)
  progress              Json?               @map("progress") // Store latest progress state (step, percent)
  qa_attempts           Json? // WR-6.1: per-attempt QA history array
  adrs                  Adr[]
  aiCostLogs            AICostLog[]
  aiDecisionLogs        AIDecisionLog[]
  approvalRecords       ApprovalRecord[]
  bug_escapes           BugEscape[]
  selected_account      AiAccount?          @relation(fields: [selected_account_id], references: [id], onDelete: SetNull)
  ticket                Ticket              @relation(fields: [ticket_id], references: [id])
  fileLockQueueEntries  FileLockQueue[]
  fileLocks             FileLock[]
  qa_result             QAResult?
  qa_review_queue       QaReviewQueue?
  logs                  ExecutionLog[]
  overrides             ExecutionOverride[]
  activities            ExecutionActivity[]

  @@index([ticket_id, status])
  @@index([ai_provider, status])
  @@index([scheduled_retry_at])
  @@index([selected_account_id])
  @@map("executions")
}

model ExecutionLog {
  id          String   @id @default(uuid())
  executionId String   @map("execution_id")
  timestamp   DateTime @default(now())
  level       String // STDOUT, STDERR, INFO, WARN, ERROR, DEBUG
  message     String   @db.Text
  source      String // e.g., 'ai_provider_pty', 'github_push'
  createdAt   DateTime @default(now()) @map("created_at")

  execution Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId, timestamp])
  @@map("execution_logs")
}

/// Persisted live activity events for execution timeline
/// Each row captures a structured, human-readable activity event
/// (e.g. "AI is thinking", "Installing dependencies", "Error encountered")
model ExecutionActivity {
  id               String   @id @default(uuid())
  executionId      String   @map("execution_id")
  timestamp        DateTime @default(now())
  activity         String // Short human-readable label (e.g. "AI is thinking")
  detail           String? // Brief extra info (e.g. file path, duration)
  rawContent       String?  @map("raw_content") @db.Text // Full raw content for expandable view
  category         String // SETUP, DEPENDENCY, GIT, AI_THINKING, AI_CODING, BUILD, TEST, LINT, FILE_OP, DEPLOY, ERROR, SYSTEM
  icon             String // Lucide icon name hint for UI
  suggestedPercent Int?     @map("suggested_percent") // Progress percentage 0-100
  createdAt        DateTime @default(now()) @map("created_at")

  execution Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId, timestamp])
  @@index([executionId, category])
  @@map("execution_activities")
}

model QAResult {
  id                 String      @id @default(uuid())
  execution_id       String      @unique
  linting_passed     Boolean     @default(false)
  linting_errors     Json?
  tests_passed       Boolean     @default(false)
  test_results       Json?
  test_coverage      Float?
  code_review_passed Boolean     @default(false)
  code_review_issues Json?
  overall_passed     Boolean     @default(false)
  created_at         DateTime    @default(now())
  updated_at         DateTime    @updatedAt
  bug_escapes        BugEscape[]
  execution          Execution   @relation(fields: [execution_id], references: [id], onDelete: Cascade)

  @@index([overall_passed, created_at])
  @@map("qa_results")
}

model GitHubInstallation {
  id              String    @id @default(uuid())
  installation_id String    @unique @map("installation_id")
  account_login   String    @map("account_login")
  account_id      String    @map("account_id")
  account_type    String    @map("account_type")
  access_token    String?
  expires_at      DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  @@index([account_login])
  @@map("github_installations")
}

model GitHubPush {
  id            String       @id @default(uuid())
  execution_id  String
  repository    String
  branch_name   String
  commit_sha    String?
  pr_number     Int?
  pr_url        String?
  push_status   GitHubStatus @default(PENDING)
  error_message String?
  created_at    DateTime     @default(now())
  updated_at    DateTime     @updatedAt
  deployments   Deployment[]

  @@map("github_pushes")
}

model Deployment {
  id             String           @id @default(uuid())
  github_push_id String
  environment    String
  cicd_provider  String
  build_id       String?
  status         DeploymentStatus @default(TRIGGERED)
  deployed_at    DateTime?
  created_at     DateTime         @default(now())
  updated_at     DateTime         @updatedAt
  error_message  String?
  workflow_id    String?
  github_push    GitHubPush       @relation(fields: [github_push_id], references: [id])

  // Story 9-U-4: Related production errors
  production_errors ProductionError[]

  @@index([github_push_id])
  @@index([status, environment])
  @@map("deployments")
}

model CostRecord {
  id             String     @id @default(uuid())
  ticket_id      String
  ai_provider    AIProvider
  operation_type String
  tokens_used    Int?
  api_calls      Int        @default(1)
  cost_in_cents  Int
  created_at     DateTime   @default(now())
  ticket         Ticket     @relation(fields: [ticket_id], references: [id])

  @@index([ticket_id])
  @@index([ai_provider, created_at])
  @@map("cost_records")
}

model ProductionError {
  id             String        @id @default(uuid())
  application    String
  error_type     String
  error_message  String
  stack_trace    String?
  severity       ErrorSeverity
  fix_ticket_id  String?
  fix_ticket_url String?
  resolved       Boolean       @default(false)
  occurred_at    DateTime
  created_at     DateTime      @default(now())

  // Context extraction fields (Story 9-U-4)
  parsed_stack_trace Json?   @map("parsed_stack_trace")
  user_context       Json?   @map("user_context")
  deployment_id      String? @map("deployment_id")
  affected_users     Int     @default(1) @map("affected_users")
  occurrence_count   Int     @default(1) @map("occurrence_count")

  // Dashboard fields (Story 9-U-5)
  acknowledged_at DateTime? @map("acknowledged_at")
  acknowledged_by String?   @map("acknowledged_by")
  resolved_at     DateTime? @map("resolved_at")

  // Relations
  bug_escape      BugEscape?
  deployment      Deployment?             @relation(fields: [deployment_id], references: [id])
  related_commits ProductionErrorCommit[]

  @@index([application, severity, resolved])
  @@index([deployment_id])
  @@index([acknowledged_at])
  @@index([resolved_at])
  @@map("production_errors")
}

// Story 9-U-4: Linked commits for production errors
model ProductionErrorCommit {
  id                  String   @id @default(uuid())
  production_error_id String
  commit_sha          String
  commit_message      String
  author              String
  committed_at        DateTime
  file_path           String
  relevance_score     Float
  github_url          String
  created_at          DateTime @default(now())

  production_error ProductionError @relation(fields: [production_error_id], references: [id])

  @@index([production_error_id])
  @@index([commit_sha])
  @@map("production_error_commits")
}

model Metric {
  id          String   @id @default(uuid())
  metric_name String
  metric_type String
  value       Float
  labels      Json?
  recorded_at DateTime @default(now())

  @@index([metric_name, recorded_at])
  @@map("metrics")
}

model AuditLog {
  id           String   @id @default(uuid())
  entity_type  String
  entity_id    String
  action       String
  actor_type   String
  actor_id     String?
  before_state Json?
  after_state  Json?
  created_at   DateTime @default(now())

  @@index([entity_type, entity_id])
  @@index([created_at])
  @@map("audit_logs")
}

model ContextDocument {
  id                String            @id @default(uuid())
  ticket_id         String
  original_filename String
  file_format       ContextFileFormat
  file_size_bytes   Int
  file_hash         String            @unique
  storage_path      String
  extracted_text    String
  extraction_status ExtractionStatus  @default(PENDING)
  extraction_error  String?
  document_title    String?
  document_type     String?
  content_summary   String?
  content_hash      String?
  cached_at         DateTime?
  cache_expires_at  DateTime?
  created_at        DateTime          @default(now())
  updated_at        DateTime          @updatedAt
  ticket            Ticket            @relation(fields: [ticket_id], references: [id], onDelete: Cascade)

  @@index([ticket_id])
  @@index([file_hash])
  @@index([extraction_status])
  @@map("context_documents")
}

model CoverageBaseline {
  id         String   @id @default(uuid())
  project_id String   @unique
  branch     String   @default("main")
  lines      Float
  branches   Float
  functions  Float
  statements Float
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  project    Project  @relation(fields: [project_id], references: [id])

  @@unique([project_id, branch])
  @@index([project_id])
  @@map("coverage_baselines")
}

model ProjectCoverageConfig {
  id          String   @id @default(uuid())
  project_id  String   @unique
  threshold   Float    @default(80)
  enforcement Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  project     Project  @relation(fields: [project_id], references: [id])

  @@map("project_coverage_configs")
}

model WebhookEvent {
  id           String   @id
  source       String
  event_type   String
  payload      Json
  processed_at DateTime @default(now())

  @@index([source, event_type, processed_at])
  @@map("webhook_events")
}

model AIDecisionLog {
  id           String     @id @default(uuid())
  timestamp    DateTime   @default(now())
  agent_name   String
  action       String
  reasoning    String
  ticket_id    String
  execution_id String?
  input_data   Json
  output_data  Json
  confidence   Float
  execution    Execution? @relation(fields: [execution_id], references: [id])

  @@index([ticket_id, timestamp])
  @@index([execution_id])
  @@index([agent_name])
  @@index([timestamp])
  @@index([confidence, timestamp])
  @@map("ai_decision_logs")
}

model FileLock {
  id           String         @id @default(uuid())
  ticket_id    String
  execution_id String
  file_path    String
  locked_at    DateTime       @default(now())
  released_at  DateTime?
  status       FileLockStatus @default(LOCKED)
  execution    Execution      @relation(fields: [execution_id], references: [id], onDelete: Cascade)

  @@unique([ticket_id, file_path])
  @@index([execution_id])
  @@index([status])
  @@index([ticket_id])
  @@map("file_locks")
}

model FileLockQueue {
  id           String              @id @default(uuid())
  ticket_id    String
  execution_id String
  file_path    String
  requested_at DateTime            @default(now())
  acquired_at  DateTime?
  status       FileLockQueueStatus @default(WAITING)
  execution    Execution           @relation(fields: [execution_id], references: [id], onDelete: Cascade)

  @@unique([ticket_id, execution_id, file_path])
  @@index([file_path, status, requested_at])
  @@index([ticket_id])
  @@index([execution_id])
  @@map("file_lock_queue")
}

model AICostLog {
  id                  String     @id @default(uuid())
  execution_id        String?
  ticket_id           String?
  timestamp           DateTime   @default(now())
  ai_provider         AIProvider
  model_name          String
  operation_type      String
  tokens_input        Int?
  tokens_output       Int?
  tokens_total        Int?
  cost_usd            Decimal    @db.Decimal(10, 6)
  skill               String?
  project_id          String?
  selected_account_id String?
  duration_ms         Int?
  execution           Execution? @relation(fields: [execution_id], references: [id])
  ticket              Ticket?    @relation(fields: [ticket_id], references: [id])

  @@index([execution_id])
  @@index([ticket_id, timestamp])
  @@index([ai_provider, timestamp])
  @@index([skill, timestamp])
  @@index([project_id, skill])
  @@map("ai_cost_logs")
}

model TicketDependency {
  id                String             @id @default(uuid())
  ticket_id         String
  depends_on        String
  type              DependencyEdgeType @default(waiting_on)
  source            String             @default("clickup")
  status            DependencyStatus   @default(WAITING)
  circular_detected Boolean            @default(false)
  created_at        DateTime           @default(now())
  resolved_at       DateTime?
  estimated_eta     DateTime?
  eta_calculated_at DateTime?

  @@unique([ticket_id, depends_on, source])
  @@index([ticket_id])
  @@index([depends_on])
  @@index([status])
  @@map("ticket_dependencies")
}

model ApprovalRecord {
  id           String           @id @default(uuid())
  execution_id String
  pm_id        String
  decision     ApprovalDecision
  reasoning    String?
  created_at   DateTime         @default(now())
  execution    Execution        @relation(fields: [execution_id], references: [id], onDelete: Cascade)

  @@index([execution_id])
  @@map("approval_records")
}

model ProductionApproval {
  id              String           @id @default(uuid())
  ticket_id       String
  approver_id     String
  decision        ApprovalDecision
  override_reason String?
  created_at      DateTime         @default(now())
  ticket          Ticket           @relation(fields: [ticket_id], references: [id])

  @@index([ticket_id])
  @@index([approver_id])
  @@map("production_approvals")
}

model BugEscape {
  id                    String          @id @default(uuid())
  production_error_id   String          @unique
  ticket_id             String
  execution_id          String?
  qa_result_id          String?
  qa_review_queue_id    String?
  escape_category       EscapeCategory
  severity_at_detection ErrorSeverity
  detected_at           DateTime
  resolved_at           DateTime?
  resolution_time_hours Float?
  project_id            String
  ai_provider           String?
  complexity_score      Int?
  created_at            DateTime        @default(now())
  execution             Execution?      @relation(fields: [execution_id], references: [id])
  production_error      ProductionError @relation(fields: [production_error_id], references: [id])
  qa_result             QAResult?       @relation(fields: [qa_result_id], references: [id])
  qa_review_queue       QaReviewQueue?  @relation(fields: [qa_review_queue_id], references: [id])
  ticket                Ticket          @relation(fields: [ticket_id], references: [id])

  @@index([project_id, detected_at])
  @@index([detected_at])
  @@index([escape_category])
  @@index([ai_provider, detected_at])
  @@map("bug_escapes")
}

model AiCodeReview {
  id                     String                @id @default(uuid())
  queue_item_id          String
  review_version         Int                   @default(1)
  generated_at           DateTime              @default(now())
  ai_model               String
  confidence_score       Decimal               @db.Decimal(3, 2)
  overall_assessment     String
  summary                String
  findings               Json
  generation_duration_ms Int
  token_usage            Json?
  cost_usd               Decimal?              @db.Decimal(10, 6)
  cache_key              String?               @unique
  expires_at             DateTime?
  created_at             DateTime              @default(now())
  updated_at             DateTime              @updatedAt
  finding_statuses       AiCodeReviewFinding[]
  queue_item             QaReviewQueue         @relation(fields: [queue_item_id], references: [id])

  @@unique([queue_item_id, review_version])
  @@index([queue_item_id])
  @@index([generated_at])
  @@index([cache_key])
  @@map("ai_code_reviews")
}

model AiCodeReviewFinding {
  id           String       @id @default(uuid())
  ai_review_id String
  finding_key  String
  finding_type String
  severity     String
  file_path    String?
  line_number  Int?
  description  String
  suggestion   String?
  status       String       @default("PENDING")
  reviewed_by  String?
  reviewed_at  DateTime?
  review_notes String?
  created_at   DateTime     @default(now())
  updated_at   DateTime     @updatedAt
  ai_review    AiCodeReview @relation(fields: [ai_review_id], references: [id], onDelete: Cascade)

  @@index([ai_review_id])
  @@index([status])
  @@index([finding_key])
  @@map("ai_code_review_findings")
}

model User {
  id                           String                     @id
  email                        String                     @unique
  role                         String                     @default("PM")
  managed_by_id                String?
  max_tickets                  Int                        @default(20)
  created_at                   DateTime                   @default(now())
  updated_at                   DateTime                   @updatedAt
  full_name                    String
  is_active                    Boolean                    @default(true)
  last_login_at                DateTime?
  password_hash                String
  conversations                ClientConversation[]       @relation("PMConversations")
  quality_gate_history         QualityGateConfigHistory[]
  quality_gate_configs_created QualityGateConfig[]        @relation("QualityGateConfigCreatedBy")
  quality_gate_configs_updated QualityGateConfig[]        @relation("QualityGateConfigUpdatedBy")
  refreshTokens                RefreshToken[]
  invitations                  UserInvitation[]           @relation("InvitedBy")
  manager                      User?                      @relation("ManagerTeam", fields: [managed_by_id], references: [id])
  team_members                 User[]                     @relation("ManagerTeam")
  utilization_history          UtilizationHistory[]
  execution_overrides          ExecutionOverride[]
  slackMemberId                String?                    @map("slack_member_id")
  notificationPreferences      NotificationPreference[]
  inAppNotifications           InAppNotification[]
  gitHubAccounts               GitHubAccount[]
  connectedApps                ConnectedApp[]

  @@index([managed_by_id])
  @@index([role])
  @@index([email])
  @@map("users")
}

model UtilizationHistory {
  id              String   @id @default(uuid())
  pm_id           String
  snapshot_date   DateTime @default(now()) @db.Date
  active_tickets  Int
  max_tickets     Int
  utilization_pct Float
  created_at      DateTime @default(now())
  pm              User     @relation(fields: [pm_id], references: [id], onDelete: Cascade)

  @@unique([pm_id, snapshot_date])
  @@index([pm_id, snapshot_date])
  @@index([snapshot_date])
  @@map("utilization_history")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model ClientConversation {
  id                String   @id @default(uuid())
  project_id        String
  pm_id             String
  conversation_date DateTime
  title             String
  transcript        String
  summary           String?
  action_items      Json[]
  sentiment         String?
  audio_file_url    String?
  status            String   @default("uploaded")
  processing_cost   Float?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
  clickup_task_ids  Json?
  pm                User     @relation("PMConversations", fields: [pm_id], references: [id])
  project           Project  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  linked_tickets    Ticket[] @relation("ConversationTickets")

  @@index([project_id, conversation_date])
  @@index([sentiment])
  @@index([status])
  @@map("client_conversations")
}

model Report {
  id         String       @id @default(uuid())
  project_id String
  type       ReportType   @default(SPRINT)
  status     ReportStatus @default(PENDING)
  title      String
  date_start DateTime
  date_end   DateTime
  raw_data   Json?
  summary    String?
  narrative  String?
  insights   String?
  file_urls  Json?
  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt
  project    Project      @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([project_id, date_start, date_end])
  @@map("reports")
}

model SystemConfig {
  key         String   @id
  value       String
  description String?
  is_secret   Boolean  @default(false)
  updated_by  String?
  updated_at  DateTime @updatedAt

  @@map("system_configs")
}

model Adr {
  id                          String     @id @default(uuid())
  execution_id                String?
  ticket_id                   String?
  title                       String
